[user]
	name = Ryan Manly
	email = ryan.manly@gmail.com
[filter "media"]
	clean = git-media-clean %f
	smudge = git-media-smudge %f
[core]
	excludesfile = ~/.gitignore
	pager = less -r
[credential]
	help = osxkeychain
[push]
	default = simple
# [difftool]
# 	prompt = false
[pull]
	ff = only
[color]
	ui = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
